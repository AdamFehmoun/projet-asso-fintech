# =============================================================================
# Fahm.io — Environment variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# Schema is validated at boot in src/lib/env.ts (Zod) — missing or malformed
# values will crash the server with a precise error message.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Project URL — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=

# Anon key — exposed to the browser, safe with RLS enabled
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
# Used for GPT-4o Vision (receipt OCR) and embeddings (category sync).
# Get a key at: https://platform.openai.com/api-keys
# Must start with "sk-".
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys

# Secret key (sk_test_... in dev, sk_live_... in prod)
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...) — required to verify webhook payloads.
# In local dev, get one from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Upstash Redis (rate limiting)
# -----------------------------------------------------------------------------
# Used to cap OCR scans at 10/hour/user and protect other expensive endpoints.
# Create a database at: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL of the app — used for OAuth callbacks, Stripe redirects,
# and absolute URLs in generated PDFs. Example: http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=
